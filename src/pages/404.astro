---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404 — Angel Serrano" description="Página no encontrada" lang="es">
  <main class="flex min-h-screen flex-col items-center justify-center px-4 text-center">
    <p class="font-mono text-sky-600">404</p>
    <h1 class="mt-2 text-4xl font-bold text-stone-900">Página no encontrada</h1>
    <p class="mt-3 text-stone-500">Page not found</p>
    <a href="/" class="mt-8 rounded-full bg-gradient-to-r from-sky-500 to-violet-500 px-5 py-3 font-semibold text-white">Volver al inicio</a>
  </main>
</Layout>
